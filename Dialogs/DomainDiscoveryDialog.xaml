<Window x:Class="Veil.Dialogs.DomainDiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Related domains"
        Width="520"
        WindowStartupLocation="CenterOwner">
    <StackPanel>
        <StackPanel Margin="20,4,20,16">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" LineHeight="19" />

            <TextBlock Text="Group name" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
            <TextBox x:Name="GroupNameTextBox" />

            <Grid Margin="0,16,0,6">
                <TextBlock x:Name="CountText" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Select all" Style="{StaticResource LinkButton}" Click="SelectAll_Click" />
                    <Button Content="Select none" Style="{StaticResource LinkButton}" Margin="14,0,0,0" Click="SelectNone_Click" />
                </StackPanel>
            </Grid>
            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}">
                <ListBox x:Name="DomainsList" MaxHeight="260" Padding="4" ItemContainerStyle="{StaticResource PlainListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Domain}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="Selection_Changed" Unchecked="Selection_Changed" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
        <Border Style="{StaticResource DialogFooter}">
            <Grid>
                <Button x:Name="WithoutGroupButton" HorizontalAlignment="Left" MinWidth="96" Click="WithoutGroup_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" MinWidth="96" />
                    <Button x:Name="AddGroupButton" Content="Add group" IsDefault="True" MinWidth="110" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="AddGroup_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
