<Window x:Class="Veil.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        Title="Veil"
        Width="460"
        WindowStartupLocation="CenterOwner">
    <StackPanel>
        <Grid Margin="20,6,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="IconBadge" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top" Background="{StaticResource AccentSoftBrush}">
                <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="16" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Margin="14,7,0,0"
                       TextWrapping="Wrap"
                       LineHeight="19" />
            <CheckBox x:Name="OptionCheckBox" Grid.Row="1" Grid.Column="1" Margin="14,16,0,0" Visibility="Collapsed" />
        </Grid>
        <Border Style="{StaticResource DialogFooter}">
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </StackPanel>
</Window>
