<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Veil</Product>
    <AssemblyTitle>Veil</AssemblyTitle>
    <AssemblyName>Veil</AssemblyName>
    <RootNamespace>Veil</RootNamespace>
    <Version>0.2.1</Version>
    <Authors>Veil contributors</Authors>
    <Description>Windows WPF client for TrustTunnel VPN with split tunneling and server setup tools.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- Only ship framework resources for the languages Veil supports. -->
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Keep tests, build output and release folders out of the app's default item globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Veil.Tests\**;artifacts\**;release\**;dist\**;docs\**;engine\**;installer\**;ui-previews\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Fonts\Manrope.ttf" />
    <Content Include="Assets\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\tray_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="client\trusttunnel_client.exe" Condition="Exists('client\trusttunnel_client.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="client\wintun.dll" Condition="Exists('client\wintun.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
