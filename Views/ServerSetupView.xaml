<UserControl x:Class="Veil.Views.ServerSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Veil.Ui">
    <UserControl.Resources>
        <Style x:Key="StepRow" TargetType="Border">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="StepIcon" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,4,32,28" MaxWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                <TextBlock Text="Server setup" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Install or update the TrustTunnel endpoint on your own Linux server over SSH, then copy its settings into Veil. The server needs a domain name pointing to it for the TLS certificate." />
            </StackPanel>

            <!-- Form -->
            <StackPanel x:Name="FormPanel" Grid.Row="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SSH access" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Server IP or hostname" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HostTextBox" Tag="203.0.113.10" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SSH port" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SshPortTextBox" Tag="22" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="SSH user" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SshUserTextBox" Tag="root" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Sign in with" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                        <Border Style="{StaticResource SegmentedHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PasswordAuthOption" Style="{StaticResource SegmentedRadio}" GroupName="SshAuth" Content="Password" IsChecked="True" Checked="AuthOption_Checked" />
                                <RadioButton x:Name="KeyAuthOption" Style="{StaticResource SegmentedRadio}" GroupName="SshAuth" Content="Key file" Checked="AuthOption_Checked" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SshPasswordPanel" Margin="0,12,0,0">
                            <TextBlock Text="SSH password" Style="{StaticResource FieldLabel}" />
                            <ui:PasswordField x:Name="SshPasswordField" />
                        </StackPanel>
                        <StackPanel x:Name="SshKeyPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="Private key file" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SshKeyPathTextBox" Tag="C:\Users\you\.ssh\id_ed25519" />
                                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseKeyButton_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="VPN endpoint" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Domain" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DomainTextBox" Tag="vpn.example.com" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Email for Let's Encrypt" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="EmailTextBox" Tag="you@example.com" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Listen port" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ListenPortTextBox" Tag="443" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="VPN username" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="VpnUsernameTextBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                <TextBlock Text="VPN password" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:PasswordField x:Name="VpnPasswordField" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Click="GeneratePasswordButton_Click" ToolTip="Generate a random 16-character password">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="13" />
                                            <TextBlock Text="Generate" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource SectionHint}" Margin="0,12,0,0"
                                   Text="Passwords are only kept in memory and are never written to disk." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Progress -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Progress" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="StepText" Text="Ready to install" Style="{StaticResource SectionHint}" Margin="0,4,0,10" />
                    <ProgressBar x:Name="SetupProgress" Minimum="0" Maximum="7" />

                    <StackPanel Margin="0,10,0,0">
                        <Border Style="{StaticResource StepRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SshStepIcon" Style="{StaticResource StepIcon}">
                                    <TextBlock x:Name="SshStepGlyph" Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Connect over SSH" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="SshStepStatus" Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource StepRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="InstallStepIcon" Style="{StaticResource StepIcon}">
                                    <TextBlock x:Name="InstallStepGlyph" Text="2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Install the endpoint" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="InstallStepStatus" Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource StepRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CertificateStepIcon" Style="{StaticResource StepIcon}">
                                    <TextBlock x:Name="CertificateStepGlyph" Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Get a TLS certificate" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="CertificateStepStatus" Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource StepRow}" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ServiceStepIcon" Style="{StaticResource StepIcon}">
                                    <TextBlock x:Name="ServiceStepGlyph" Text="4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Start and verify the service" Margin="10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ServiceStepStatus" Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="InstallButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock x:Name="InstallButtonText" Text="Install server" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ApplyButton" Margin="0,8,0,0" HorizontalAlignment="Stretch" IsEnabled="False" Click="ApplyButton_Click"
                            ToolTip="Copy the server address, port and VPN credentials into the Connection page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FB;" Style="{StaticResource Icon}" FontSize="13" />
                            <TextBlock Text="Use this server in Veil" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Expander x:Name="LogExpander" Margin="0,14,0,0">
                        <Expander.Header>
                            <TextBlock Text="Installer output" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel Margin="-18,6,0,0">
                            <TextBox x:Name="SetupLogTextBox" Style="{StaticResource LogTextBox}" Height="220" />
                            <Button Content="Clear output" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ClearLogButton_Click" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
