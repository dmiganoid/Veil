<UserControl x:Class="Veil.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,4,32,28" MaxWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Connection status -->
            <Border Style="{StaticResource Card}" Padding="30,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="StatePill" Style="{StaticResource Badge}" HorizontalAlignment="Left" Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatePillText" Style="{StaticResource BadgeText}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StatusTitle" Text="Disconnected" FontSize="30" FontWeight="Bold" Margin="0,14,0,0" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource PageSubtitle}" FontSize="14" />
                        <TextBlock x:Name="DurationText" Style="{StaticResource CaptionText}" FontSize="12" Margin="0,10,0,0" />

                        <Border x:Name="ErrorBox" Margin="0,16,0,0" Padding="12,10" CornerRadius="{StaticResource ControlRadius}"
                                Background="{StaticResource DangerSoftBrush}" BorderBrush="#55F2687A" BorderThickness="1" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Button x:Name="SetupLink" Style="{StaticResource LinkButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="SetupLink_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Set up the connection" />
                                <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="11" Margin="6,1,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="32,0,10,0" VerticalAlignment="Center">
                        <Button x:Name="PowerButton" Width="140" Height="140" Cursor="Hand" Click="PowerButton_Click"
                                AutomationProperties.Name="Connect or disconnect">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                        <ContentPresenter />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Ellipse x:Name="PowerHalo" Opacity="0.16" />
                                <Ellipse x:Name="PowerRing" Margin="12" StrokeThickness="2" Fill="{StaticResource SurfaceRaisedBrush}" />
                                <TextBlock x:Name="PowerGlyph" Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="40" />
                            </Grid>
                        </Button>
                        <TextBlock x:Name="PowerCaption" Text="Connect" HorizontalAlignment="Center" Margin="0,10,0,0"
                                   FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SERVER" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="ServerValueText" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="ServerDetailText" Style="{StaticResource SectionHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <Button Style="{StaticResource LinkButton}" Content="Edit connection" Margin="0,14,0,0" HorizontalAlignment="Left" Click="EditConnection_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TUNNEL" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="TunnelValueText" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="TunnelDetailText" Style="{StaticResource SectionHint}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ROUTING" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="RoutingValueText" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="RoutingDetailText" Style="{StaticResource SectionHint}" />
                        <Button Style="{StaticResource LinkButton}" Content="Edit rules" Margin="0,14,0,0" HorizontalAlignment="Left" Click="EditRules_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource MutedText}" FontSize="12" Margin="2,16,0,0" />
        </Grid>
    </ScrollViewer>
</UserControl>
