<UserControl x:Class="Veil.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TabCount" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ListFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <Style x:Key="EmptyText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,2,2,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="9" />
        </Style>

        <DataTemplate x:Key="RuleTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Badge" Style="{StaticResource Badge}" HorizontalAlignment="Left" Background="{StaticResource VpnSoftBrush}">
                        <TextBlock x:Name="BadgeText" Text="{Binding BadgeText}" Style="{StaticResource BadgeText}" Foreground="{StaticResource VpnBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontWeight="Normal" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ExpandButton" Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Show domains"
                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" Click="ToggleGroup_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Rename group"
                                Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}" Click="RenameGroup_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" ToolTip="{Binding SwitchToolTip}"
                                Visibility="{Binding CanSwitchRoute, Converter={StaticResource BoolToVisibility}}" Click="SwitchRoute_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove" Click="RemoveRule_Click" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding GroupDomains}" Margin="76,8,0,2"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Domain}" VerticalAlignment="Center" FontSize="12" />
                                    <Button Style="{StaticResource ChipButton}" Content="&#xE711;" ToolTip="Remove from group" Margin="4,0,0,0" Click="RemoveGroupDomain_Click" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBypass}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="{StaticResource BypassSoftBrush}" />
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource BypassBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                    <Setter TargetName="SubtitleText" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ExpandButton" Property="Content" Value="&#xE70E;" />
                    <Setter TargetName="ExpandButton" Property="ToolTip" Value="Hide domains" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,4,32,24" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Routing" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Choose which traffic uses the VPN. Changes are saved right away and take effect when you connect." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border x:Name="ProxyNotice" Style="{StaticResource NoticeBorder}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Veil is set to System proxy mode, where routing rules are not used. Switch to Full tunnel to apply them." />
                    <Button Grid.Column="2" Content="Open connection settings" MinHeight="28" Click="OpenSettings_Click" />
                </Grid>
            </Border>
            <Border x:Name="ReconnectNotice" Style="{StaticResource NoticeBorder}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Routing changed while Veil is connected. Reconnect to apply the new rules." />
                    <Button x:Name="ReconnectButton" Grid.Column="2" Content="Reconnect" MinHeight="28" Click="ReconnectButton_Click" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Default route -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="GeneralOption" Style="{StaticResource OptionCard}" GroupName="RoutingMode" Checked="Mode_Checked">
                <StackPanel>
                    <TextBlock Text="Everything through VPN" FontWeight="SemiBold" />
                    <TextBlock Text="Your rules pick what bypasses the VPN, for example local sites, games or streaming." Style="{StaticResource SectionHint}" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="SelectiveOption" Grid.Column="2" Style="{StaticResource OptionCard}" GroupName="RoutingMode" Checked="Mode_Checked">
                <StackPanel>
                    <TextBlock Text="Only selected through VPN" FontWeight="SemiBold" />
                    <TextBlock Text="Only your rules use the VPN. Everything else connects directly." Style="{StaticResource SectionHint}" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="3" Margin="0,18,0,0">
            <!-- Domains & IPs -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Domains &amp; IPs" />
                        <Border Style="{StaticResource TabCount}">
                            <TextBlock x:Name="DomainsCountText" Text="0" FontSize="11" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RuleInput" Tag="example.com, *.example.com or 203.0.113.0/24" KeyDown="RuleInput_KeyDown" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentedHost}" Margin="10,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BypassAction" Style="{StaticResource SegmentedRadio}" GroupName="RuleAction" Content="Bypass VPN" />
                                <RadioButton x:Name="VpnAction" Style="{StaticResource SegmentedRadio}" GroupName="RuleAction" Content="Through VPN" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="AddRuleButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="AddRuleButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Add" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RuleHelpText" Style="{StaticResource SectionHint}" Margin="0" />
                        <CheckBox x:Name="DiscoverCheckBox" Grid.Column="1" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Top"
                                  Content="Offer related domains"
                                  ToolTip="When you add a site, Veil looks for the domains it loads content from (CDNs, APIs) and offers to add them as a group." />
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource ListFrame}">
                        <Grid>
                            <ListBox x:Name="RulesList" ItemTemplate="{StaticResource RuleTemplate}" ItemContainerStyle="{StaticResource PlainListItem}" />
                            <TextBlock x:Name="RulesEmptyText" Style="{StaticResource EmptyText}" />
                        </Grid>
                    </Border>

                    <Expander x:Name="SuggestionsExpander" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                        <Expander.Header>
                            <TextBlock x:Name="SuggestionsHeader" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHint}" Margin="0,0,0,8"
                                       Text="Domains from the engine log that are not covered by a rule yet. Add one as a rule or hide it." />
                            <ItemsControl x:Name="SuggestionsList" MaxHeight="120">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                                                <Button Style="{StaticResource ChipButton}" Content="&#xE710;" ToolTip="Add as a rule" Margin="4,0,0,0" Click="AddSuggestion_Click" />
                                                <Button Style="{StaticResource ChipButton}" Content="&#xE711;" ToolTip="Hide" Click="HideSuggestion_Click" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource LinkButton}" Content="Hide all" HorizontalAlignment="Left" Margin="0,4,0,0" Click="HideAllSuggestions_Click" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </TabItem>

            <!-- Apps -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Apps" />
                        <Border Style="{StaticResource TabCount}">
                            <TextBlock x:Name="AppsCountText" Text="0" FontSize="11" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AppSearchBox" Tag="Search installed apps" TextChanged="AppSearchBox_TextChanged" />
                        <CheckBox x:Name="AppsSelectedOnly" Grid.Column="1" Content="Selected only" Margin="14,0,14,0" VerticalAlignment="Center"
                                  Checked="AppsFilter_Changed" Unchecked="AppsFilter_Changed" />
                        <Button x:Name="RefreshAppsButton" Grid.Column="2" Click="RefreshAppsButton_Click" ToolTip="Scan installed apps again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Refresh" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="AppsHintText" Grid.Row="1" Style="{StaticResource SectionHint}" Margin="0,8,0,12" />

                    <Border Grid.Row="2" Style="{StaticResource ListFrame}">
                        <Grid>
                            <ListBox x:Name="AppsList" ItemContainerStyle="{StaticResource PlainListItem}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="26" Height="26">
                                                    <TextBlock Text="&#xECAA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource SubtleBrush}" />
                                                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource CaptionText}" FontWeight="Normal" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding ExecutableName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Location, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="AppsEmptyText" Style="{StaticResource EmptyText}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ManualAppBox" Tag="Not in the list? Enter a process name or path, e.g. game.exe" KeyDown="ManualAppBox_KeyDown" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Click="AddManualAppButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" />
                                <TextBlock Text="Add app" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Countries -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Countries" />
                        <Border Style="{StaticResource TabCount}">
                            <TextBlock x:Name="CountriesCountText" Text="0" FontSize="11" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CountrySearchBox" Tag="Search countries" TextChanged="CountrySearchBox_TextChanged" />
                        <CheckBox x:Name="CountriesSelectedOnly" Grid.Column="1" Content="Selected only" Margin="14,0,14,0" VerticalAlignment="Center"
                                  Checked="CountriesFilter_Changed" Unchecked="CountriesFilter_Changed" />
                        <Button x:Name="ClearCountriesButton" Grid.Column="2" Content="Clear selection" Click="ClearCountriesButton_Click" />
                    </Grid>

                    <TextBlock x:Name="CountriesHintText" Grid.Row="1" Style="{StaticResource SectionHint}" Margin="0,8,0,12" />

                    <Border Grid.Row="2" Style="{StaticResource ListFrame}">
                        <Grid>
                            <ListBox x:Name="CountriesList" ItemContainerStyle="{StaticResource PlainListItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Code}" Style="{StaticResource CaptionText}" Margin="12,0,6,0" />
                                            </Grid>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="CountriesEmptyText" Style="{StaticResource EmptyText}" Text="No countries match the search." />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
