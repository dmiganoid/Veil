<UserControl x:Class="Veil.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,4,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Logs" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" ToolTip="Veil keeps the newest 500 entries." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <CheckBox x:Name="AutoScrollCheckBox" Content="Follow new entries" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="CopyButton" Click="CopyButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Copy" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Click="SaveButton_Click" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Save…" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClearButton" Click="ClearButton_Click" Margin="8,0,0,0" Style="{StaticResource DangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" />
                        <TextBlock Text="Clear" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBox x:Name="LogTextBox" Style="{StaticResource LogTextBox}" />
            <TextBlock x:Name="EmptyText"
                       Text="Nothing logged yet. Connect to see what the VPN engine is doing."
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Grid>
    </Grid>
</UserControl>
