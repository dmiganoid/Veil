<Window x:Class="Veil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Veil" Height="780" Width="1180" MinHeight="720" MinWidth="1040"
        Icon="pack://application:,,,/Veil;component/Assets/icon.png"
        WindowStyle="None" ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent" Closing="Window_Closing" SizeChanged="Window_SizeChanged"
        FontFamily="./Assets/Fonts/#Manrope" SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <FontFamily x:Key="UiFont">./Assets/Fonts/#Manrope</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <Color x:Key="ShellColor">#050B18</Color>
        <Color x:Key="PanelColor">#9A162642</Color>
        <Color x:Key="PanelStrongColor">#B021355E</Color>
        <Color x:Key="BorderColor">#44DCEBFF</Color>
        <Color x:Key="BorderStrongColor">#66DCEBFF</Color>
        <Color x:Key="TextColor">#F4F8FF</Color>
        <Color x:Key="MutedColor">#B8DAE5FF</Color>
        <Color x:Key="SoftColor">#7ADAE5FF</Color>
        <Color x:Key="CyanColor">#56D9FF</Color>
        <Color x:Key="BlueColor">#258DFF</Color>
        <Color x:Key="VioletColor">#B75CFF</Color>
        <Color x:Key="SuccessColor">#5FF1B7</Color>
        <Color x:Key="WarningColor">#FFD46B</Color>
        <Color x:Key="DangerColor">#FF7B92</Color>

        <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="PanelStrongBrush" Color="{StaticResource PanelStrongColor}" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="{StaticResource BorderStrongColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource SoftColor}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
        <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="ActiveLockBackgroundBrush" Color="#2CFFD46B" />
        <SolidColorBrush x:Key="ActiveLockBorderBrush" Color="#AAFFD46B" />
        <SolidColorBrush x:Key="ConfigStateBackgroundBrush" Color="#18258DFF" />
        <SolidColorBrush x:Key="ConfigStateBorderBrush" Color="#4456D9FF" />

        <LinearGradientBrush x:Key="ShellGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#030817" Offset="0" />
            <GradientStop Color="#07142D" Offset="0.55" />
            <GradientStop Color="#081124" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38FFFFFF" Offset="0" />
            <GradientStop Color="#101B3260" Offset="0.48" />
            <GradientStop Color="#1813283F" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2599FF" Offset="0" />
            <GradientStop Color="#8D38E6" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SubtleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#20FFFFFF" Offset="0" />
            <GradientStop Color="#10258DFF" Offset="0.52" />
            <GradientStop Color="#18B75CFF" Offset="1" />
        </LinearGradientBrush>

        <DrawingBrush x:Key="ShellGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,32,32"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,32,32"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#05FFFFFF">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,32,1" />
                                <RectangleGeometry Rect="0,0,1,32" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DropShadowEffect x:Key="GlassShadow" BlurRadius="48" ShadowDepth="18" Direction="270" Opacity="0.34" Color="#000000" />
        <DropShadowEffect x:Key="GlowCyan" BlurRadius="32" ShadowDepth="0" Opacity="0.44" Color="#56D9FF" />
        <DropShadowEffect x:Key="GlowViolet" BlurRadius="36" ShadowDepth="0" Opacity="0.42" Color="#B75CFF" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#E012203A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.42" Color="#000000" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassGradient}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{StaticResource GlassShadow}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.025" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.025" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonChrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="OrbButton" TargetType="Button">
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="250" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="OrbPulseRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid x:Name="OrbHoverRoot" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="OrbPulseRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.018" Duration="0:0:1.65" />
                                        <DoubleAnimation Storyboard.TargetName="OrbPulseRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.018" Duration="0:0:1.65" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OrbHoverRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.045" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="OrbHoverRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.045" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="OrbHoverRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="OrbHoverRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.62" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFE8EC" />
            <Setter Property="Background" Value="#28FF7B92" />
            <Setter Property="BorderBrush" Value="#66FF7B92" />
        </Style>

        <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DisclosureFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <TextBlock x:Name="DisclosureChevron"
                                           Grid.Column="1"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DisclosureFrame" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="DisclosureFrame" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DisclosureFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="DisclosureFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="DisclosureFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="DisclosureFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DisclosureFrame" Property="Background" Value="{StaticResource SubtleGradient}" />
                                <Setter TargetName="DisclosureFrame" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Setter TargetName="DisclosureChevron" Property="Text" Value="&#xE70E;" />
                                <Setter TargetName="DisclosureChevron" Property="Foreground" Value="{StaticResource CyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="ChromeButtonBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChromeButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChromeButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="ChromeButtonBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#3656D9FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="Background" Value="#16000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#6637C7FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Setter TargetName="InputBorder" Property="Background" Value="#22162642" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="Background" Value="#16000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="#6637C7FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Setter TargetName="InputBorder" Property="Background" Value="#22162642" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Margin" Value="0,4,0,12" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#22162642" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="12">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,34,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Text="⌄"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,2"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="15" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#2A243A66" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#F014223A"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownToggle" Property="IsEnabled" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#162642" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBoxFrame"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="#16000000"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 3 9 L 7 13 L 15 4"
                                      Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="9,0,0,1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxFrame" Property="Background" Value="#4656D9FF" />
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,18,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="RadioFrame" Fill="#16000000" Stroke="{StaticResource BorderBrushSoft}" StrokeThickness="1" />
                                <Ellipse x:Name="RadioDot" Width="8" Height="8" Fill="{StaticResource CyanBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RadioFrame" Property="Stroke" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="RadioFrame" Property="Fill" Value="#2256D9FF" />
                                <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RadioFrame" Property="Stroke" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#26DCEBFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Background" Value="#02000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="ScrollBarRoot" Width="7" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" Background="#30DCEBFF" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="ScrollBarRoot" Property="Width" Value="Auto" />
                                <Setter TargetName="ScrollBarRoot" Property="Height" Value="7" />
                                <Setter Property="Height" Value="7" />
                                <Setter Property="MinHeight" Value="7" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#08000000" />
                                <Setter TargetName="ScrollThumb" Property="Background" Value="#55DCEBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#10000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="ListFrame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ListFrame" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ListFrame" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#00000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="#08FFFFFF"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SubtleGradient}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </Style>

        <Style x:Key="NavListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Border x:Name="NavBorder"
                                    Background="#0DFFFFFF"
                                    BorderBrush="#00000000"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1CFFFFFF" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.08" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="NavBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.08" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="NavBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SubtleGradient}" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="Background" Value="#20000000" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="8"
                                        Background="{StaticResource PrimaryGradient}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootShell" Background="Transparent">
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Background="{StaticResource ShellGradient}" Padding="14" CornerRadius="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,18" ToolTip="Veil">
                        <Border Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Center" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" Effect="{StaticResource GlowCyan}" RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Veil;component/Assets/logo.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Border>

                    <ListBox x:Name="NavList" Grid.Row="1" SelectionChanged="NavList_SelectionChanged"
                             Width="60" Padding="0" BorderThickness="0" Background="Transparent" SelectedIndex="0" Margin="0,18,0,0"
                             HorizontalContentAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource NavListItem}">
                        <ListBoxItem ToolTip="Home">
                            <Border Width="44" Height="44" CornerRadius="16" Background="#1856D9FF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource NavIconGlyph}" />
                            </Border>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Settings">
                            <Border Width="44" Height="44" CornerRadius="16" Background="#145FF1B7" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIconGlyph}" />
                            </Border>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Split Tunnel">
                            <Border Width="44" Height="44" CornerRadius="16" Background="#18B75CFF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE774;" Style="{StaticResource NavIconGlyph}" />
                            </Border>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Logs">
                            <Border Width="44" Height="44" CornerRadius="16" Background="#18FFD46B" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource NavIconGlyph}" />
                            </Border>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Server">
                            <Border Width="44" Height="44" CornerRadius="16" Background="#18FF7B92" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE968;" Style="{StaticResource NavIconGlyph}" />
                            </Border>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel HorizontalAlignment="Center" ToolTip="VPN core ready">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}" Effect="{StaticResource GlowCyan}" />
                            <TextBlock Text="CORE" Style="{StaticResource EyebrowText}" Foreground="{StaticResource SoftBrush}" FontSize="9" Margin="0,9,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Background="{StaticResource ShellGradient}" CornerRadius="30" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="Transparent" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="26,0,22,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PRIVATE TUNNEL CONSOLE" Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Veil" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,8,0" Background="#14FFFFFF">
                                    <TextBlock x:Name="TopProtocolText" Text="PROTOCOL" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,8,0" Background="#145FF1B7">
                                    <TextBlock x:Name="TopDnsText" Text="DNS READY" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="0,0,12,0" Background="#18B75CFF">
                                    <TextBlock x:Name="TopRouteText" Text="GENERAL" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Button x:Name="MinimizeWindowButton" Style="{StaticResource WindowChromeButton}" Click="MinimizeWindowButton_Click" ToolTip="Minimize">
                                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <Button x:Name="CloseWindowButton" Style="{StaticResource WindowChromeButton}" Click="CloseWindowButton_Click" ToolTip="Close">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ClipToBounds="True">
                        <Grid x:Name="HomeView" Margin="26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.16*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.84*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource GlassPanel}" MinHeight="570">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Home / Connection" Style="{StaticResource EyebrowText}" />
                                        <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="34" FontWeight="Bold" Margin="0,8,0,0" />
                                        <TextBlock x:Name="StatusDetailText" Text="Configure the server settings, then connect." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        <TextBlock x:Name="HomeErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,14,0,12">
                                        <Canvas Width="430" Height="326" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.44">
                                            <Path Stroke="{StaticResource CyanBrush}" StrokeThickness="1" Opacity="0.22" Data="M 52,178 C 106,118 164,100 228,132 S 340,170 382,106" />
                                            <Path Stroke="{StaticResource VioletBrush}" StrokeThickness="1" Opacity="0.22" Data="M 48,224 C 134,176 214,246 294,192 S 360,132 400,176" />
                                            <Path Stroke="{StaticResource BorderBrushStrong}" StrokeThickness="1" Opacity="0.18" Data="M 92,92 L 162,142 L 230,98 L 306,150 L 362,116" />
                                            <Path Stroke="{StaticResource BorderBrushStrong}" StrokeThickness="1" Opacity="0.14" Data="M 84,246 L 154,202 L 230,236 L 304,204 L 372,236" />
                                            <Path Stroke="{StaticResource CyanBrush}" StrokeThickness="1" Opacity="0.15" Data="M 152,48 C 214,82 246,82 306,50" />
                                            <Path Stroke="{StaticResource VioletBrush}" StrokeThickness="1" Opacity="0.15" Data="M 122,284 C 194,256 254,256 328,284" />

                                            <Ellipse Canvas.Left="49" Canvas.Top="175" Width="6" Height="6" Fill="{StaticResource CyanBrush}" Opacity="0.68" />
                                            <Ellipse Canvas.Left="89" Canvas.Top="89" Width="5" Height="5" Fill="{StaticResource CyanBrush}" Opacity="0.48" />
                                            <Ellipse Canvas.Left="159" Canvas.Top="139" Width="7" Height="7" Fill="{StaticResource VioletBrush}" Opacity="0.52" />
                                            <Ellipse Canvas.Left="226" Canvas.Top="94" Width="8" Height="8" Fill="{StaticResource CyanBrush}" Opacity="0.48" />
                                            <Ellipse Canvas.Left="302" Canvas.Top="146" Width="7" Height="7" Fill="{StaticResource VioletBrush}" Opacity="0.58" />
                                            <Ellipse Canvas.Left="379" Canvas.Top="103" Width="6" Height="6" Fill="{StaticResource VioletBrush}" Opacity="0.64" />
                                            <Ellipse Canvas.Left="81" Canvas.Top="243" Width="5" Height="5" Fill="{StaticResource CyanBrush}" Opacity="0.44" />
                                            <Ellipse Canvas.Left="151" Canvas.Top="199" Width="6" Height="6" Fill="{StaticResource CyanBrush}" Opacity="0.56" />
                                            <Ellipse Canvas.Left="227" Canvas.Top="233" Width="7" Height="7" Fill="{StaticResource VioletBrush}" Opacity="0.42" />
                                            <Ellipse Canvas.Left="301" Canvas.Top="201" Width="6" Height="6" Fill="{StaticResource CyanBrush}" Opacity="0.42" />
                                            <Ellipse Canvas.Left="369" Canvas.Top="233" Width="5" Height="5" Fill="{StaticResource VioletBrush}" Opacity="0.48" />
                                        </Canvas>
                                        <Ellipse Width="342" Height="342" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource BorderBrushStrong}" StrokeThickness="1.5" Fill="#11000000" Effect="{StaticResource GlowCyan}" />
                                        <Ellipse x:Name="ConnectOrbRing" Width="374" Height="374" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource VioletBrush}" StrokeThickness="2" StrokeDashArray="3 7" Opacity="0.62" Effect="{StaticResource GlowViolet}" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:18" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Button x:Name="ConnectButton" Style="{StaticResource OrbButton}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ConnectButton_Click">
                                            <Grid>
                                                <Border x:Name="ConnectOrbSurface" CornerRadius="125"
                                                        BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1.5" Background="#CC091326" Effect="{StaticResource GlowCyan}" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image Source="pack://application:,,,/Veil;component/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <Border x:Name="ConnectOrbStateBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="15" Padding="14,5" Background="#D00B1528">
                                                    <TextBlock x:Name="ConnectOrbStateText" Text="OFFLINE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <StackPanel Grid.Row="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="18" Background="#14FFFFFF">
                                                <StackPanel>
                                                    <TextBlock Text="Server" Style="{StaticResource MutedText}" />
                                                    <TextBlock x:Name="HomeServerSummaryText" Text="Not configured" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="HomeAddressSummaryText" Text="Open Settings" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="18" Background="#18B75CFF">
                                                <StackPanel>
                                                    <TextBlock Text="Mode" Style="{StaticResource MutedText}" />
                                                    <TextBlock x:Name="HomeModeSummaryText" Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                    <TextBlock x:Name="HomeSplitSummaryText" Text="All traffic via VPN" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="22" Padding="18" Background="#18FFD46B">
                                                <StackPanel>
                                                    <TextBlock Text="Protocol" Style="{StaticResource MutedText}" />
                                                    <TextBlock x:Name="HomeProtocolSummaryText" Text="HTTP/3" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                    <TextBlock x:Name="HomePortSummaryText" Text="Port 443" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Connection Parameters" FontSize="18" FontWeight="SemiBold" />
                                            <Border HorizontalAlignment="Right" Background="#2256D9FF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="10,4">
                                                <TextBlock Text="CONFIG" Style="{StaticResource EyebrowText}" FontSize="10" />
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Hostname" Style="{StaticResource MutedText}" />
                                            <TextBlock x:Name="HomeHostnameValueText" Grid.Column="1" Text="-" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" Text="Address" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                            <TextBlock x:Name="HomeAddressValueText" Grid.Row="1" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="Port" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                            <TextBlock x:Name="HomePortValueText" Grid.Row="2" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,10,0,0" />
                                            <TextBlock Grid.Row="3" Text="Protocol" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                                            <TextBlock x:Name="HomeProtocolValueText" Grid.Row="3" Grid.Column="1" Text="-" HorizontalAlignment="Right" Margin="0,10,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Protection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                                        <UniformGrid Columns="2" Rows="2">
                                            <Border x:Name="HomeIpv6Tile" CornerRadius="18" Background="#165FF1B7" BorderBrush="#555FF1B7" BorderThickness="1" Padding="14" Margin="0,0,8,8">
                                                <StackPanel><TextBlock Text="IPv6" FontWeight="SemiBold" /><TextBlock x:Name="HomeIpv6ValueText" Text="-" Style="{StaticResource MutedText}" /></StackPanel>
                                            </Border>
                                            <Border x:Name="HomeAntiDpiTile" CornerRadius="18" Background="#165FF1B7" BorderBrush="#555FF1B7" BorderThickness="1" Padding="14" Margin="8,0,0,8">
                                                <StackPanel><TextBlock Text="Anti-DPI" FontWeight="SemiBold" /><TextBlock x:Name="HomeAntiDpiValueText" Text="-" Style="{StaticResource MutedText}" /></StackPanel>
                                            </Border>
                                            <Border x:Name="HomeDnsTile" CornerRadius="18" Background="#1856D9FF" BorderBrush="#5556D9FF" BorderThickness="1" Padding="14" Margin="0,8,8,0">
                                                <StackPanel><TextBlock Text="DNS" FontWeight="SemiBold" /><TextBlock x:Name="HomeDnsValueText" Text="-" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            </Border>
                                            <Border x:Name="HomePostQuantumTile" CornerRadius="18" Background="#18FFD46B" BorderBrush="#55FFD46B" BorderThickness="1" Padding="14" Margin="8,8,0,0">
                                                <StackPanel><TextBlock Text="PQ" FontWeight="SemiBold" /><TextBlock x:Name="HomePostQuantumValueText" Text="-" Style="{StaticResource MutedText}" /></StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource GlassPanel}">
                                    <TextBlock x:Name="HomeHintText" Text="Ready to connect. Tap the Veil orb to start the private tunnel." Style="{StaticResource MutedText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="SettingsView" Visibility="Collapsed">
                            <Grid Margin="22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Settings" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="Client Parameters" FontSize="31" FontWeight="Bold" Margin="0,8,0,0" />
                                        <Border x:Name="SettingsWarningBanner"
                                                Visibility="Collapsed"
                                                BorderBrush="{StaticResource ActiveLockBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="12,8"
                                                Margin="0,10,0,0"
                                                Background="{StaticResource ActiveLockBackgroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Margin="0,1,9,0" />
                                                <TextBlock x:Name="SettingsWarningText"
                                                           Grid.Column="1"
                                                           Text="Disconnect from VPN before changing settings."
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button x:Name="ImportConfigButton" Click="ImportConfigButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Import JSON" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ExportConfigButton" Click="ExportConfigButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Export JSON" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SaveSettingsButton" Click="SaveSettingsButton_Click" MinWidth="120" Style="{StaticResource PrimaryButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="Save" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GlassPanel}">
                                        <StackPanel>
                                            <TextBlock Text="Server and Credentials" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Hostname" Style="{StaticResource FieldLabel}" /><TextBox x:Name="HostnameTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Server IP / address" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AddressTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PortTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Username" Style="{StaticResource FieldLabel}" /><TextBox x:Name="UsernameTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <PasswordBox x:Name="PasswordInput" />
                                                            <TextBox x:Name="PasswordVisibleTextBox" Visibility="Collapsed" />
                                                        </Grid>
                                                        <Button x:Name="TogglePasswordVisibilityButton" Grid.Column="2" Content="Show" Click="TogglePasswordVisibilityButton_Click" MinWidth="64" Margin="0,4,0,12" Padding="14,7" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"><TextBlock Text="DNS upstream" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DnsTextBox" /></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="Custom SNI" Style="{StaticResource FieldLabel}" /><TextBox x:Name="CustomSniTextBox" /></StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,10" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Protocol and Diagnostics" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                                                <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="ProtocolComboBox">
                                                    <ComboBoxItem Content="http2" />
                                                    <ComboBoxItem Content="http3" />
                                                </ComboBox>
                                                <TextBlock Text="Log Level" Style="{StaticResource FieldLabel}" />
                                                <ComboBox x:Name="LogLevelComboBox">
                                                    <ComboBoxItem Content="error" />
                                                    <ComboBoxItem Content="warn" />
                                                    <ComboBoxItem Content="info" />
                                                    <ComboBoxItem Content="debug" />
                                                    <ComboBoxItem Content="trace" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource GlassPanel}" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="Tunnel Flags" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                <Border x:Name="SettingsNoticeBorder" BorderBrush="{StaticResource ConfigStateBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,5" Margin="0,0,0,7" Background="{StaticResource ConfigStateBackgroundBrush}">
                                                    <StackPanel>
                                                        <TextBlock Text="CONFIG STATE" Style="{StaticResource EyebrowText}" FontSize="10" />
                                                        <TextBlock x:Name="SettingsNoticeText" Text="Editable now. Save, then reconnect Veil." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,0,5" Background="#0EFFFFFF">
                                                    <CheckBox x:Name="Ipv6CheckBox" Content="IPv6 Support" />
                                                </Border>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,0,5" Background="#0EFFFFFF">
                                                    <CheckBox x:Name="SkipVerificationCheckBox" Content="Skip Certificate Verification" />
                                                </Border>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,0,5" Background="#0EFFFFFF">
                                                    <CheckBox x:Name="AntiDpiCheckBox" Content="Anti-DPI" />
                                                </Border>
                                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,4" Background="#0EFFFFFF">
                                                    <CheckBox x:Name="PostQuantumCheckBox" Content="Post-Quantum Key Exchange" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid x:Name="SplitView" Visibility="Collapsed" Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Split Tunnel" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="Traffic Rules" FontSize="27" FontWeight="Bold" Margin="0,4,0,0" />
                                    <TextBlock x:Name="SplitWarningText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Padding="12" Margin="0,8,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Routing mode" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="General bypasses selected rules. Selective sends only selected rules through VPN." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="GeneralModeRadio" Content="General" GroupName="VpnMode" Checked="VpnModeRadio_Checked" />
                                        <RadioButton x:Name="SelectiveModeRadio" Content="Selective" GroupName="VpnMode" Checked="VpnModeRadio_Checked" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" MinHeight="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="310" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Edit rules" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Pick one source. The editor opens on the right." Style="{StaticResource MutedText}" Margin="0,4,0,12" />

                                        <ToggleButton x:Name="AppsSectionToggle" Style="{StaticResource DisclosureToggle}" IsChecked="True" Checked="SplitSectionToggle_Checked" Unchecked="SplitSectionToggle_Unchecked" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Applications" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="AppsModeHelpText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1C5FF1B7" BorderBrush="#555FF1B7" BorderThickness="1" CornerRadius="14" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock x:Name="SelectedAppsText" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </ToggleButton>

                                        <ToggleButton x:Name="DomainSectionToggle" Style="{StaticResource DisclosureToggle}" Checked="SplitSectionToggle_Checked" Unchecked="SplitSectionToggle_Unchecked" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Domains" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="DomainModeHelpText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1C56D9FF" BorderBrush="#5556D9FF" BorderThickness="1" CornerRadius="14" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock x:Name="SelectedDomainsText" Foreground="{StaticResource CyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </ToggleButton>

                                        <ToggleButton x:Name="GeoIpSectionToggle" Style="{StaticResource DisclosureToggle}" Checked="SplitSectionToggle_Checked" Unchecked="SplitSectionToggle_Unchecked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="GeoIP" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="CountriesModeHelpText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1CB75CFF" BorderBrush="#55B75CFF" BorderThickness="1" CornerRadius="14" Padding="10,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock x:Name="SelectedCountriesText" Foreground="{StaticResource VioletBrush}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </ToggleButton>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Padding="14">
                                    <Grid MinHeight="0">
                                        <Grid Visibility="{Binding IsChecked, ElementName=AppsSectionToggle, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Applications" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="Choose installed apps, or add a process name such as deadlock.exe." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" Margin="0,8,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.05*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="0.95*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Find installed app" Style="{StaticResource FieldLabel}" />
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="AppSearchTextBox" Grid.Column="0" MinWidth="180" Margin="0,2,0,0" TextChanged="AppSearchTextBox_TextChanged" ToolTip="Search by app name or executable name" />
                                                        <Button x:Name="RefreshAppsButton" Grid.Column="2" Click="RefreshAppsButton_Click" Margin="0,2,0,0" Padding="13,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                                                                <TextBlock Text="Refresh" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Add executable manually" Style="{StaticResource FieldLabel}" />
                                                    <Grid Grid.Row="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="ManualAppTextBox" Grid.Column="0" MinWidth="180" Margin="0,2,0,0" ToolTip="Enter a process executable name or path, for example game.exe" />
                                                        <Button x:Name="AddManualAppButton" Grid.Column="2" Click="AddManualAppButton_Click" Style="{StaticResource PrimaryButton}" Margin="0,2,0,0" Padding="13,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                                                                <TextBlock Text="Add" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                            <Grid Grid.Row="2" MinHeight="0">
                                                <ListBox x:Name="AppsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                                <Border x:Name="AppsEmptyState" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" CornerRadius="18" Padding="18" Background="#0EFFFFFF" IsHitTestVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="No applications found" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                        <TextBlock Text="Refresh discovery or add a process manually." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsChecked, ElementName=DomainSectionToggle, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Domains" FontSize="20" FontWeight="SemiBold" />
                                                    <TextBlock Text="Add a host or domain that needs its own route." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="DomainEntryTextBox" Grid.Column="0" MinWidth="220" Margin="0,4,0,0" />
                                                <Button x:Name="AddDomainButton" Grid.Column="2" Click="AddDomainButton_Click" Style="{StaticResource PrimaryButton}" Margin="0,4,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                                                        <TextBlock Text="Add" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Row="2" MinHeight="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Single domains" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <Grid Grid.Row="1" MinHeight="0">
                                                    <ListBox x:Name="StandaloneDomainsList" />
                                                    <Border x:Name="StandaloneDomainsEmptyState" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" CornerRadius="18" Padding="14" Background="#0EFFFFFF" IsHitTestVisible="False">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="No domains yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Button x:Name="RemoveStandaloneDomainButton" Grid.Row="2" Content="Remove Selected" Click="RemoveStandaloneDomainButton_Click" Margin="0,8,8,0" MinWidth="150" HorizontalAlignment="Left" />
                                            </Grid>

                                            <ToggleButton x:Name="DomainGroupsSectionToggle" Grid.Row="3" Style="{StaticResource DisclosureToggle}" Margin="0,10,0,0">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="Domain groups" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="Optional sets for related domains." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </ToggleButton>

                                            <Grid Grid.Row="4" Visibility="{Binding IsChecked, ElementName=DomainGroupsSectionToggle, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0" MaxHeight="185">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid MinHeight="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid>
                                                        <ListBox x:Name="DomainGroupsList" DisplayMemberPath="Name" SelectionChanged="DomainGroupsList_SelectionChanged" />
                                                        <Border x:Name="DomainGroupsEmptyState" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" CornerRadius="18" Padding="14" Background="#0EFFFFFF" IsHitTestVisible="False">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="No groups" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Grid.Column="2">
                                                        <ListBox x:Name="GroupDomainsList" />
                                                        <Border x:Name="GroupDomainsEmptyState" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="16" Padding="14" Background="#08FFFFFF" IsHitTestVisible="False">
                                                            <TextBlock Text="Select a group." Style="{StaticResource MutedText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                    <Button x:Name="AddDomainToSelectedGroupButton" Content="Add To Group" Click="AddDomainToSelectedGroupButton_Click" />
                                                    <Button x:Name="RenameGroupButton" Content="Rename" Click="RenameGroupButton_Click" />
                                                    <Button x:Name="DeleteGroupButton" Content="Delete" Click="DeleteGroupButton_Click" Style="{StaticResource DangerButton}" />
                                                    <Button x:Name="RemoveGroupDomainButton" Content="Remove From Group" Click="RemoveGroupDomainButton_Click" />
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>

                                        <Grid Visibility="{Binding IsChecked, ElementName=GeoIpSectionToggle, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="GeoIP Countries" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="Select countries by ISO code or country name." Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                                            </StackPanel>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="GeoIpCountrySearchTextBox" Grid.Column="0" MinWidth="180" Margin="0,4,0,10" TextChanged="GeoIpCountrySearchTextBox_TextChanged" ToolTip="Search by country name or ISO code" />
                                                <Button x:Name="ClearGeoIpCountriesButton" Grid.Column="2" Click="ClearGeoIpCountriesButton_Click" Margin="0,4,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" />
                                                        <TextBlock Text="Clear" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Row="2" MinHeight="0">
                                                <ListBox x:Name="GeoIpCountriesList" />
                                                <Border x:Name="GeoIpCountriesEmptyState" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" CornerRadius="18" Padding="18" Background="#0EFFFFFF" IsHitTestVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="No countries found" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                        <TextBlock Text="Change the search query or clear the filter." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border x:Name="SuggestionsPanel" Grid.Row="3" Style="{StaticResource GlassPanel}" Background="#25258DFF" BorderBrush="#6656D9FF" Padding="10" Margin="0,8,0,0" MaxHeight="82" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Detected in logs" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ListBox x:Name="SuggestionsList" Grid.Column="2" Height="40" Margin="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                    </Grid>
                                    <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="AddSuggestionStandaloneButton" Content="Add Standalone" Click="AddSuggestionStandaloneButton_Click" />
                                        <ComboBox x:Name="SuggestionGroupComboBox" DisplayMemberPath="Name" MinWidth="160" Margin="0,4,8,4" />
                                        <Button x:Name="AddSuggestionToGroupButton" Content="Add To Group" Click="AddSuggestionToGroupButton_Click" />
                                        <Button Content="Hide" Click="HideSuggestionButton_Click" />
                                        <Button Content="Hide All" Click="HideAllSuggestionsButton_Click" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="LogsView" Visibility="Collapsed" Margin="26">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Logs" Style="{StaticResource EyebrowText}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Client Event Stream" FontSize="31" FontWeight="Bold" />
                                        <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="15" Padding="11,5" Margin="14,7,0,0" Background="#1856D9FF" VerticalAlignment="Top">
                                            <TextBlock Text="LIVE" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="LogsCountText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Button x:Name="CopyLogsButton" Click="CopyLogsButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Copy" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ClearLogsButton" Click="ClearLogsButton_Click" Style="{StaticResource DangerButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Clear" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="0,18,0,0" Padding="18">
                                <Grid>
                                    <Border Background="#BA030817" BorderBrush="#24DCEBFF" BorderThickness="1" CornerRadius="18" />
                                    <TextBox x:Name="LogsTextBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" Background="Transparent"
                                             Foreground="#DDF4F8FF" BorderThickness="0" Padding="14" />
                                    <Border x:Name="LogsEmptyState" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1"
                                            CornerRadius="20" Padding="24" Margin="22" Background="#0EFFFFFF" IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="No client events yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            <TextBlock Text="Connection, tunnel and split-routing events will appear here." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="ServerView" Visibility="Collapsed">
                            <Grid Margin="22">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Server Setup" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="Install or Update Server" FontSize="31" FontWeight="Bold" Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Button x:Name="InstallServerButton" MinWidth="150" Click="InstallServerButton_Click"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Install Server" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.08*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="0.92*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="14">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="SSH and Certificate" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="SSH host" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerHostTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="SSH port" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerSshPortTextBox" Text="22" /></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="SSH user" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerSshUserTextBox" Text="root" /></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2">
                                                    <TextBlock Text="Authentication" Style="{StaticResource FieldLabel}" />
                                                    <Border Height="47" Margin="0,4,0,12" CornerRadius="12" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" Background="#0EFFFFFF" Padding="12,0">
                                                        <CheckBox x:Name="ServerUseKeyCheckBox" Content="Use SSH key" Checked="ServerUseKeyCheckBox_Changed" Unchecked="ServerUseKeyCheckBox_Changed" Margin="0" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel x:Name="ServerSshPasswordPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                    <TextBlock Text="SSH password" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <PasswordBox x:Name="ServerSshPasswordInput" />
                                                            <TextBox x:Name="ServerSshPasswordVisibleTextBox" Visibility="Collapsed" />
                                                        </Grid>
                                                        <Button x:Name="ToggleServerSshPasswordVisibilityButton" Grid.Column="2" Content="Show" Click="ToggleServerSshPasswordVisibilityButton_Click" MinWidth="64" Margin="0,4,0,12" Padding="14,7" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel x:Name="ServerSshKeyPanel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed">
                                                    <TextBlock Text="SSH key file" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="ServerSshKeyPathTextBox" Grid.Column="0" />
                                                        <Button x:Name="BrowseSshKeyButton" Grid.Column="2" Content="Browse" Click="BrowseSshKeyButton_Click" MinWidth="78" Margin="0,4,0,12" Padding="14,7" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Server domain" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerDomainTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Email for certificate" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerEmailTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Listen port" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerListenPortTextBox" Text="443" /></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="VPN username" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ServerVpnUsernameTextBox" /></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                                    <TextBlock Text="VPN password" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Column="0">
                                                            <PasswordBox x:Name="ServerVpnPasswordInput" />
                                                            <TextBox x:Name="ServerVpnPasswordVisibleTextBox" Visibility="Collapsed" />
                                                        </Grid>
                                                        <Button x:Name="ToggleServerVpnPasswordVisibilityButton" Grid.Column="2" Content="Show" Click="ToggleServerVpnPasswordVisibilityButton_Click" MinWidth="64" Margin="0,4,0,12" Padding="14,7" />
                                                        <Button x:Name="GenerateVpnPasswordButton" Grid.Column="4" Content="Generate" Click="GenerateVpnPasswordButton_Click" MinWidth="84" Margin="0,4,0,12" Padding="14,7" />
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>

                                    <Grid Grid.Column="2" MinHeight="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Style="{StaticResource GlassPanel}" Padding="14" MinHeight="0">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="0,0,6,0">
                                                    <TextBlock Text="Progress" FontSize="19" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ServerStepText" Text="Ready to install" FontWeight="SemiBold" Margin="0,8,0,5" />
                                                    <ProgressBar x:Name="ServerProgressBar" Minimum="0" Maximum="7" Height="12" />
                                                    <StackPanel Margin="0,8,0,0">
                                                        <Border x:Name="SetupMilestoneSsh" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,5" Margin="0,0,0,4" Background="#0EFFFFFF">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="1" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="SSH access" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="SetupMilestoneSshStatus" Grid.Column="2" Text="READY" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="SetupMilestoneInstall" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,5" Margin="0,0,0,4" Background="#0EFFFFFF">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="2" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="Install Veil" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="SetupMilestoneInstallStatus" Grid.Column="2" Text="QUEUED" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="SetupMilestoneCertificate" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,5" Margin="0,0,0,4" Background="#0EFFFFFF">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="3" Foreground="{StaticResource VioletBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="Certificate" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="SetupMilestoneCertificateStatus" Grid.Column="2" Text="QUEUED" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                            </Grid>
                                                        </Border>
                                                        <Border x:Name="SetupMilestoneService" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14" Padding="9,5" Background="#0EFFFFFF">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="28" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="4" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="Service check" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock x:Name="SetupMilestoneServiceStatus" Grid.Column="2" Text="QUEUED" Style="{StaticResource EyebrowText}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button x:Name="ApplyServerSettingsButton" Content="Apply Client Settings" Click="ApplyServerSettingsButton_Click" IsEnabled="False" Margin="0,8,8,0" />
                                                    <ToggleButton x:Name="ServerLogsSectionToggle" Style="{StaticResource DisclosureToggle}" Margin="0,8,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Setup Logs" FontSize="17" FontWeight="SemiBold" />
                                                            <TextBlock Text="Installer output." Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Grid Visibility="{Binding IsChecked, ElementName=ServerLogsSectionToggle, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0" Height="170">
                                                        <Border Background="#BA030817" BorderBrush="#24DCEBFF" BorderThickness="1" CornerRadius="18" />
                                                        <TextBox x:Name="ServerLogTextBox" IsReadOnly="True"
                                                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                                 FontFamily="{StaticResource MonoFont}" Background="Transparent"
                                                                 Foreground="#DDF4F8FF" BorderThickness="0" Padding="14" />
                                                        <Border x:Name="ServerLogEmptyState" BorderBrush="{StaticResource BorderBrushStrong}" BorderThickness="1" CornerRadius="18" Padding="20" Margin="18" Background="#0EFFFFFF" IsHitTestVisible="False">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" />
                                                                <TextBlock Text="No logs yet" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
