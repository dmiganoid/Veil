<Window x:Class="Veil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veil"
        Width="1120" Height="740"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Veil;component/Assets/icon.png"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,6,0,0">
                    <Image Source="pack://application:,,,/Veil;component/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Veil" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         Grid.Row="1"
                         Margin="10,8,10,0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged"
                         KeyboardNavigation.DirectionalNavigation="Cycle">
                    <ListBoxItem Tag="Home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="15" Width="20" />
                            <TextBlock Text="Home" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Routing">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="15" Width="20" />
                            <TextBlock Text="Routing" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Width="20" />
                            <TextBlock Text="Connection" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Logs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="15" Width="20" />
                            <TextBlock Text="Logs" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Server">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="15" Width="20" />
                            <TextBlock Text="Server setup" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Row="2" Margin="12" Padding="12,10" CornerRadius="{StaticResource ControlRadius}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock x:Name="SidebarStatusText" Text="Disconnected" FontWeight="SemiBold" />
                            <TextBlock x:Name="SidebarServerText" Text="" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;" ToolTip="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" ToolTip="Maximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeButton_Click" />
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
        </Grid>
    </Grid>
</Window>
