<Window x:Class="Veil.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veil"
        Width="460"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Color x:Key="TextColor">#F4F8FF</Color>
        <Color x:Key="MutedColor">#B8DAE5FF</Color>
        <Color x:Key="CyanColor">#56D9FF</Color>
        <Color x:Key="SuccessColor">#5FF1B7</Color>
        <Color x:Key="WarningColor">#FFD46B</Color>
        <Color x:Key="DangerColor">#FF7B92</Color>

        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#44DCEBFF" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#66DCEBFF" />

        <LinearGradientBrush x:Key="ShellGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#07142D" Offset="0" />
            <GradientStop Color="#091B3A" Offset="0.52" />
            <GradientStop Color="#121735" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2599FF" Offset="0" />
            <GradientStop Color="#8D38E6" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="38" ShadowDepth="14" Direction="270" Opacity="0.42" Color="#000000" />
        <DropShadowEffect x:Key="IconGlow" BlurRadius="26" ShadowDepth="0" Opacity="0.4" Color="#56D9FF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                            <Trigger Property="IsCancel" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="28"
            Background="{StaticResource ShellGradient}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Transparent"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="22,16,14,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="HeaderIconBadge"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#1C56D9FF"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                Effect="{StaticResource IconGlow}">
                            <TextBlock x:Name="HeaderIconText"
                                       Text="&#xE946;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource CyanBrush}" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VEIL MESSAGE" Foreground="{StaticResource CyanBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="CaptionText" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="CloseButton" Style="{StaticResource ChromeButton}" Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="24,22,24,22"
                       FontSize="14"
                       LineHeight="21"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="ButtonsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,22,22" />
        </Grid>
    </Border>
</Window>
