<UserControl x:Class="Veil.Ui.PasswordField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <PasswordBox x:Name="HiddenInput" Padding="9,0,40,0" PasswordChanged="HiddenInput_PasswordChanged" />
        <TextBox x:Name="VisibleInput" Padding="9,0,40,0" Visibility="Collapsed" TextChanged="VisibleInput_TextChanged" />
        <Button x:Name="ToggleButton"
                Style="{StaticResource IconButton}"
                HorizontalAlignment="Right"
                Margin="0,0,3,0"
                Content="&#xE7B3;"
                ToolTip="Show password"
                Focusable="False"
                Click="ToggleButton_Click" />
    </Grid>
</UserControl>
