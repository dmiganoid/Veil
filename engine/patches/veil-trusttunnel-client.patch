+std::string DomainFilter::normalize_app_name(std::string_view app_name) {
+    size_t last_separator = app_name.find_last_of("\\/");
+    if (last_separator != std::string_view::npos) {
+        app_name.remove_prefix(last_separator + 1);
+    }
+
+    std::string result(app_name);
+    std::transform(result.begin(), result.end(), result.begin(), [](unsigned char ch) {
+        return static_cast<char>(std::tolower(ch));
+    });
+    return result;
