diff --git a/tcpip/src/process_resolver.cpp b/tcpip/src/process_resolver.cpp
new file mode 100644
index 0000000..af20df5
--- /dev/null
+++ b/tcpip/src/process_resolver.cpp
@@ -0,0 +1,297 @@
+#include "process_resolver.h"
+
+#include "vpn/platform.h"
+
+#include <algorithm>
+#include <cstring>
+#include <string_view>
+#include <vector>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace ag {
+
+#ifdef _WIN32
+
+static DWORD network_port(const SocketAddress &addr) {
+    return htons(addr.port());
+}
+
+static bool is_ipv4(const SocketAddress &addr) {
+    return addr.c_sockaddr() != nullptr && addr.c_sockaddr()->sa_family == AF_INET;
+}
+
+static bool is_ipv6(const SocketAddress &addr) {
+    return addr.c_sockaddr() != nullptr && addr.c_sockaddr()->sa_family == AF_INET6;
+}
+
+static const sockaddr_in *as_ipv4(const SocketAddress &addr) {
+    return (const sockaddr_in *) addr.c_sockaddr();
+}
+
+static const sockaddr_in6 *as_ipv6(const SocketAddress &addr) {
+    return (const sockaddr_in6 *) addr.c_sockaddr();
+}
+
+static bool ipv4_matches(DWORD row_addr, const SocketAddress &addr) {
+    return is_ipv4(addr) && row_addr == as_ipv4(addr)->sin_addr.S_un.S_addr;
+}
+
+static bool ipv6_matches(const UCHAR row_addr[16], const SocketAddress &addr) {
+    return is_ipv6(addr) && std::memcmp(row_addr, as_ipv6(addr)->sin6_addr.s6_addr, 16) == 0;
+}
+
+static bool ipv6_is_any(const UCHAR row_addr[16]) {
+    return std::all_of(row_addr, row_addr + 16, [](UCHAR b) { return b == 0; });
+}
+
+static std::string utf8_basename(std::wstring_view path) {
+    const size_t separator = path.find_last_of(L"\\/");
+    if (separator != std::wstring_view::npos) {
+        path.remove_prefix(separator + 1);
+    }
+
+    if (path.empty() || path.length() > INT_MAX) {
+        return {};
+    }
+
+    int required = WideCharToMultiByte(CP_UTF8, 0, path.data(), (int) path.length(), nullptr, 0, nullptr, nullptr);
+    if (required <= 0) {
+        return {};
+    }
+
+    std::string result((size_t) required, '\0');
+    int written = WideCharToMultiByte(
+            CP_UTF8, 0, path.data(), (int) path.length(), result.data(), required, nullptr, nullptr);
+    if (written <= 0) {
+        return {};
+    }
+
+    result.resize((size_t) written);
+    return result;
+}
+
+static std::string process_name_from_pid(DWORD pid) {
+    if (pid == 0) {
+        return {};
+    }
+
+    HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+    if (process == nullptr) {
+        return {};
+    }
+
+    std::wstring path(32768, L'\0');
+    DWORD size = (DWORD) path.size();
+    if (!QueryFullProcessImageNameW(process, 0, path.data(), &size)) {
+        CloseHandle(process);
+        return {};
+    }
+
+    CloseHandle(process);
+    path.resize(size);
+    return utf8_basename(path);
+}
+
+static DWORD unique_pid_or_ambiguous(DWORD current, bool &ambiguous, DWORD candidate) {
+    if (candidate == 0) {
+        return current;
+    }
+
+    if (current == 0) {
+        return candidate;
+    }
+
+    if (current != candidate) {
+        ambiguous = true;
+    }
+
+    return current;
+}
+
+static DWORD lookup_tcp4_owner_pid(const SocketAddress &src, const SocketAddress &dst) {
+    ULONG size = 0;
+    ULONG status = GetExtendedTcpTable(nullptr, &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);
+    if (status != ERROR_INSUFFICIENT_BUFFER || size == 0) {
+        return 0;
+    }
+
+    std::vector<uint8_t> buffer(size);
+    status = GetExtendedTcpTable(buffer.data(), &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);
+    if (status != ERROR_SUCCESS) {
+        return 0;
+    }
+
+    const auto *table = (const MIB_TCPTABLE_OWNER_PID *) buffer.data();
+    const DWORD src_port = network_port(src);
+    const DWORD dst_port = network_port(dst);
+    DWORD fallback_pid = 0;
+    bool fallback_ambiguous = false;
+
+    for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+        const MIB_TCPROW_OWNER_PID &row = table->table[i];
+        if (row.dwLocalPort != src_port || row.dwRemotePort != dst_port || !ipv4_matches(row.dwRemoteAddr, dst)) {
+            continue;
+        }
+
+        if (ipv4_matches(row.dwLocalAddr, src)) {
+            return row.dwOwningPid;
+        }
+
+        if (row.dwLocalAddr == INADDR_ANY) {
+            fallback_pid = unique_pid_or_ambiguous(fallback_pid, fallback_ambiguous, row.dwOwningPid);
+        }
+    }
+
+    return fallback_ambiguous ? 0 : fallback_pid;
+}
+
+static DWORD lookup_tcp6_owner_pid(const SocketAddress &src, const SocketAddress &dst) {
+    ULONG size = 0;
+    ULONG status = GetExtendedTcpTable(nullptr, &size, FALSE, AF_INET6, TCP_TABLE_OWNER_PID_ALL, 0);
+    if (status != ERROR_INSUFFICIENT_BUFFER || size == 0) {
+        return 0;
+    }
+
+    std::vector<uint8_t> buffer(size);
+    status = GetExtendedTcpTable(buffer.data(), &size, FALSE, AF_INET6, TCP_TABLE_OWNER_PID_ALL, 0);
+    if (status != ERROR_SUCCESS) {
+        return 0;
+    }
+
+    const auto *table = (const MIB_TCP6TABLE_OWNER_PID *) buffer.data();
+    const DWORD src_port = network_port(src);
+    const DWORD dst_port = network_port(dst);
+    DWORD fallback_pid = 0;
+    bool fallback_ambiguous = false;
+
+    for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+        const MIB_TCP6ROW_OWNER_PID &row = table->table[i];
+        if (row.dwLocalPort != src_port || row.dwRemotePort != dst_port || !ipv6_matches(row.ucRemoteAddr, dst)) {
+            continue;
+        }
+
+        if (ipv6_matches(row.ucLocalAddr, src)) {
+            return row.dwOwningPid;
+        }
+
+        if (ipv6_is_any(row.ucLocalAddr)) {
+            fallback_pid = unique_pid_or_ambiguous(fallback_pid, fallback_ambiguous, row.dwOwningPid);
+        }
+    }
+
+    return fallback_ambiguous ? 0 : fallback_pid;
+}
+
+static DWORD lookup_udp4_owner_pid(const SocketAddress &src) {
+    ULONG size = 0;
+    ULONG status = GetExtendedUdpTable(nullptr, &size, FALSE, AF_INET, UDP_TABLE_OWNER_PID, 0);
+    if (status != ERROR_INSUFFICIENT_BUFFER || size == 0) {
+        return 0;
+    }
+
+    std::vector<uint8_t> buffer(size);
+    status = GetExtendedUdpTable(buffer.data(), &size, FALSE, AF_INET, UDP_TABLE_OWNER_PID, 0);
+    if (status != ERROR_SUCCESS) {
+        return 0;
+    }
+
+    const auto *table = (const MIB_UDPTABLE_OWNER_PID *) buffer.data();
+    const DWORD src_port = network_port(src);
+    DWORD fallback_pid = 0;
+    bool fallback_ambiguous = false;
+
+    for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+        const MIB_UDPROW_OWNER_PID &row = table->table[i];
+        if (row.dwLocalPort != src_port) {
+            continue;
+        }
+
+        if (ipv4_matches(row.dwLocalAddr, src)) {
+            return row.dwOwningPid;
+        }
+
+        if (row.dwLocalAddr == INADDR_ANY) {
+            fallback_pid = unique_pid_or_ambiguous(fallback_pid, fallback_ambiguous, row.dwOwningPid);
+        }
+    }
+
+    return fallback_ambiguous ? 0 : fallback_pid;
+}
+
+static DWORD lookup_udp6_owner_pid(const SocketAddress &src) {
+    ULONG size = 0;
+    ULONG status = GetExtendedUdpTable(nullptr, &size, FALSE, AF_INET6, UDP_TABLE_OWNER_PID, 0);
+    if (status != ERROR_INSUFFICIENT_BUFFER || size == 0) {
+        return 0;
+    }
+
+    std::vector<uint8_t> buffer(size);
+    status = GetExtendedUdpTable(buffer.data(), &size, FALSE, AF_INET6, UDP_TABLE_OWNER_PID, 0);
+    if (status != ERROR_SUCCESS) {
+        return 0;
+    }
+
+    const auto *table = (const MIB_UDP6TABLE_OWNER_PID *) buffer.data();
+    const DWORD src_port = network_port(src);
+    DWORD fallback_pid = 0;
+    bool fallback_ambiguous = false;
+
+    for (DWORD i = 0; i < table->dwNumEntries; ++i) {
+        const MIB_UDP6ROW_OWNER_PID &row = table->table[i];
+        if (row.dwLocalPort != src_port) {
+            continue;
+        }
+
+        if (ipv6_matches(row.ucLocalAddr, src)) {
+            return row.dwOwningPid;
+        }
+
+        if (ipv6_is_any(row.ucLocalAddr)) {
+            fallback_pid = unique_pid_or_ambiguous(fallback_pid, fallback_ambiguous, row.dwOwningPid);
+        }
+    }
+
+    return fallback_ambiguous ? 0 : fallback_pid;
+}
+
+static DWORD lookup_owner_pid(int proto, const SocketAddress &src, const SocketAddress &dst) {
+    if (proto == IPPROTO_TCP) {
+        if (is_ipv4(src) && is_ipv4(dst)) {
+            return lookup_tcp4_owner_pid(src, dst);
+        }
+
+        if (is_ipv6(src) && is_ipv6(dst)) {
+            return lookup_tcp6_owner_pid(src, dst);
+        }
+    }
+
+    if (proto == IPPROTO_UDP) {
+        if (is_ipv4(src)) {
+            return lookup_udp4_owner_pid(src);
+        }
+
+        if (is_ipv6(src)) {
+            return lookup_udp6_owner_pid(src);
+        }
+    }
+
+    return 0;
+}
+
+#endif // _WIN32
+
+std::string tcpip_resolve_process_name(int proto, const SocketAddress &src, const SocketAddress &dst) {
+#ifdef _WIN32
+    return process_name_from_pid(lookup_owner_pid(proto, src, dst));
+#else
+    (void) proto;
+    (void) src;
+    (void) dst;
+    return {};
+#endif
+}
+
+} // namespace ag
